@prefix sub:  <https://pod.vardeman.me/vault/ontology/substrate#> .
@prefix wiki: <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

<> a sub:DerivedClassAffordance ;
    rdfs:label "Hub navigation" ;
    sub:deriveClass wiki:Hub ;
    sub:threshold 3 ;
    sh:agentInstruction "Hub navigation is served, not queried: read the container's derived index.md, then navigate skos:broader / skos:narrower edges in the concept's .meta." .
