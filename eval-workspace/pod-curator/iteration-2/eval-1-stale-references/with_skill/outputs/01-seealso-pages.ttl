# Finding 1: storage description rdfs:seeAlso -> /vault/wiki/pages/ returns 404.
# The pages/ container was D98-renamed to concepts/. The overlay storage-patch.ttl
# was already migrated to concepts/, but the static void-description.json still
# emits the old pages/ seeAlso term, so the merged .well-known/solid carries both.

<urn:uuid:66c5ff8d-cb17-4ad9-a751-c6a8ab49223a>
    a as:Announce, mem:RealignAction, prov:Activity ;
    as:actor <urn:agent:claude-code> ;
    as:target </vault/wiki/working/curator-proposals/> ;
    as:object <https://pod.vardeman.me/vault/.well-known/solid> ;
    prov:wasAssociatedWith <urn:agent:claude-code> ;
    prov:used <https://pod.vardeman.me/vault/settings/publicTypeIndex> ;       # ground truth: skos:Concept -> wiki/concepts/
    prov:wasDerivedFrom <https://pod.vardeman.me/vault/wiki/pages/> ;          # the stale target (404)
    mem:stalenessClass mem:MovedTarget ;
    mem:rationale "Storage description rdfs:seeAlso names /vault/wiki/pages/ which 404s. Type Index reg0-wiki-memory routes skos:Concept to /vault/wiki/concepts/, and concepts/ resolves 200. Container was renamed pages->concepts under D98. The overlay storage-patch.ttl already lists concepts/; the stale pages/ term survives in the static StaticStorageDescriber config (additive, so both appear in the merged description). Realign the static config toward the deployed/decision truth: drop the pages/ seeAlso term (concepts/ is already emitted by the overlay, so no replacement term is needed in static config)." ;
    as:published "2026-05-23T22:33:41Z"^^xsd:dateTime .

# --- Concrete proposed change (REPO-side; not HTTP-PATCHable) ---
# StaticStorageDescriber terms are assembled at server boot from the static
# config; .well-known/solid PATCH returns 405. Fix belongs in the repo.
#
# File: css/config/void-description.json  (cogitarelink-solid)
# Remove the StaticStorageDescriber block at lines 210-219:
#
#   {
#     "comment": "L3: wiki pages container (D76)",
#     "@type": "StaticStorageDescriber",
#     "terms": [
#       { "StaticStorageDescriber:_terms_key":   "http://www.w3.org/2000/01/rdf-schema#seeAlso",
#         "StaticStorageDescriber:_terms_value": "https://pod.vardeman.me/vault/wiki/pages/" }
#     ]
#   },
#
# The overlay overlays/wiki-memory/storage-patch.ttl already inserts
# rdfs:seeAlso <../wiki/concepts/>, so concepts/ remains advertised after removal.
# Verify with `make reset` then re-run pod_audit.py — finding should clear.
