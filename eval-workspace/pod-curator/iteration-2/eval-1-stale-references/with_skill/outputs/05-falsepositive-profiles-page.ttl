@prefix as:   <https://www.w3.org/ns/activitystreams#> .
@prefix mem:  <https://pod.vardeman.me/vault/ontology/mem#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# False-positive record (the playbook's named guard case).
# When sweeping the storage description's prof:hasResource list for stale
# profile targets, /vault/meta/profiles/page LOOKS like it could be a casualty
# of the pages->concepts rename. It is NOT. Recorded so the guard is auditable.

<urn:uuid:63760dc0-c2fe-416a-af92-a4d15af4c992>
    a as:Announce, mem:RealignAction, prov:Activity ;
    as:actor <urn:agent:claude-code> ;
    as:target </vault/wiki/working/curator-proposals/> ;
    as:object <https://pod.vardeman.me/vault/meta/profiles/page> ;
    prov:wasAssociatedWith <urn:agent:claude-code> ;
    prov:used <https://pod.vardeman.me/vault/meta/profiles/page> ;             # dereferenced the canonical source
    mem:stalenessClass mem:FalsePositive ;
    mem:rationale "profiles/page shares the 'page' token with the renamed pages/ container, so it looks renamed-away. Dereferenced it: profiles/page resolves 200 and its rdfs:comment is 'Root profile for all wiki-memory pages on this Pod. The wiki:Concept, wiki:Person, schema:HowTo, wiki:WorkingNote, and place/event/organization profiles all profile this one.' Every other profile carries prof:isProfileOf <.../profiles/page>. It is the load-bearing root of the PROF inheritance chain, not a container reference. WITHDRAWN — do not remove the profiles/page hasResource term or the profiles/page resource. (Mirrors the playbook's documented profiles/page false-positive guard.)" ;
    as:published "2026-05-23T22:33:41Z"^^xsd:dateTime .
