# PROPOSED corrected descriptor (repo home: overlays/addressbook/affordances/bridge-card-to-wiki.ttl)
# Same untyped gap as the contact/org affordances, same repair: it is a
# parameterized client-run SPARQL SELECT ($card), so wiki:QueryAffordance fits.
# Source container /vault/wiki/people/ verified live (200) — no dangling source.
@prefix wiki:     <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix prof:     <http://www.w3.org/ns/dx/prof/> .
@prefix wikirole: <https://pod.vardeman.me/vault/ontology/wikirole#> .

</vault/meta/affordances/bridge-card-to-wiki.ttl>
    a wiki:QueryAffordance , prof:ResourceDescriptor ;
    dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
    prof:hasRole wikirole:query-affordance ;
    rdfs:label "Bridge card to wiki page" ;
    rdfs:comment "Given a contact card IRI, find the wiki page whose foaf:primaryTopic is that card (inverts the wiki-side bridge declaration)." ;
    wiki:querySource </vault/wiki/people/> ;
    wiki:installedBy <https://pod.vardeman.me/vault/ontology/overlay#addressbook> ;
    sh:agentInstruction """
      Given a Person or Organization card IRI, find the wiki page that has
      this card as its foaf:primaryTopic. The wiki side declares the bridge;
      this query inverts it.

      Returns 0..1 wiki page URLs. Most cards have either zero (no narrative
      page yet) or one (the typical case). Multiple wiki pages targeting one
      card would be unusual but valid.

      Parameter: $card — the card IRI with hash fragment (e.g.,
      </vault/contacts/Person/c4e5.../index.ttl#this>).

      Sources required: the /vault/wiki/people/ container's .meta resources.
      Use solid-pod sparql with --default-graph-uri pointing at each relevant
      .meta (RQ-Pod-4 workaround).
    """ ;
    wiki:queryParameter [
        wiki:parameter "$card" ;
        rdfs:comment "Contact card IRI with hash fragment (named node). Required." ;
        wiki:required true
    ] ;
    wiki:selectQuery """
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?wikiPage WHERE {
  ?wikiPage foaf:primaryTopic $card .
}
    """ .
