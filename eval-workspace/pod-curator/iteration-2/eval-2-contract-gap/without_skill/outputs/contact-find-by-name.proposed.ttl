# PROPOSAL — does NOT modify the live Pod. Draft replacement for
# /vault/meta/affordances/contact-find-by-name.ttl
#
# Brings the descriptor up to the wiki-search-grep / crystallize self-description
# standard: typed as a concrete Affordance subclass, declares prof:ResourceDescriptor +
# role + installedBy + dct:conformsTo, gives it a label/comment, names its source
# graph as data (wiki:targetContainer) instead of only in prose, and enumerates the
# query parameter via wiki:queryParameter so an agent can discover the parameter
# surface without parsing the SPARQL.
#
# NOTE: this descriptor uses wiki:QueryAffordance / wikirole:query-affordance, which
# do NOT yet exist in the ontology. See report.md §"Vocabulary prerequisites" —
# proposed additions are in wiki-ontology.additions.proposed.ttl and
# wikirole.additions.proposed.ttl. If those are not adopted, fall back to the abstract
# wiki:Affordance + wikirole:affordance (already defined).

@prefix wiki:     <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix wikirole: <https://pod.vardeman.me/vault/ontology/wikirole#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix prof:     <http://www.w3.org/ns/dx/prof/> .

<>  a wiki:QueryAffordance ,
       prof:ResourceDescriptor ;
    dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
    prof:hasRole wikirole:query-affordance ;
    rdfs:label "Find contact by name" ;
    rdfs:comment "Case-insensitive full-name (vcard:fn) substring lookup across all Person and Individual cards in the AddressBook." ;
    wiki:targetContainer </vault/contacts/> ;
    wiki:installedBy <https://pod.vardeman.me/vault/ontology/overlay#addressbook> ;
    sh:agentInstruction """
      Case-insensitive full-name lookup across all Person and Individual cards.

      Parameter: $name — a string fragment to match (e.g., "Wang Wei", "Smith").
      Returns all ?person IRIs whose vcard:fn contains the fragment (case-insensitive).
      Multiple matches are expected for common names; use orcid lookup
      (contact-find-by-orcid) or affiliation (contact-find-by-affiliation) to
      disambiguate when the result set is larger than 1.

      Source graph: the aggregated contacts index at </vault/contacts/people.ttl>.
      Pass this URL as --default-graph-uri when invoking via solid-pod sparql
      (RQ-Pod-4 workaround for non-RDF resource traversal).

      Consumer CLI:
        solid-pod sparql </vault/contacts/people.ttl> \\
          --default-graph-uri https://pod.vardeman.me/vault/contacts/people.ttl \\
          "<the wiki:selectQuery below, with \\$name substituted>"
    """ ;
    wiki:queryParameter [
        wiki:parameter "name" ;
        rdfs:comment "Plain-string name fragment; matched case-insensitively against vcard:fn. Required." ;
        wiki:required true
    ] ;
    wiki:selectQuery """
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>

SELECT ?person ?fn WHERE {
  ?person vcard:fn ?fn .
  FILTER(CONTAINS(LCASE(STR(?fn)), LCASE(STR($name))))
}
    """ .
