# PROPOSAL 3 — Re-typed addressbook affordance descriptor (DO NOT APPLY; review)
#
# Target (live, MUST NOT be modified by this exercise):
#   https://pod.vardeman.me/vault/meta/affordances/contact-find-by-email.ttl
#   source: overlays/addressbook/affordances/contact-find-by-email.ttl
#
# Audit finding addressed: WARN descriptor:untyped — catalog entry was typed
# only wiki:Affordance, escaping the prof:ResourceDescriptor contract (no
# prof:hasRole / rdfs:label / dct:conformsTo / wiki:installedBy enforced).
#
# Fix: add 'a prof:ResourceDescriptor', prof:hasRole wikirole:query-affordance
# (NEW role — see proposal-2), rdfs:label, dct:conformsTo <PROF spec>, and
# wiki:installedBy <overlay#addressbook>. The existing sh:agentInstruction and
# wiki:selectQuery are preserved verbatim. These descriptors are SPARQL query
# surfaces (selectQuery run client-side), NOT ?ext= HTTP dispatch, so they are
# modeled as wikirole:query-affordance, NOT wiki:SearchAffordance.
#
# Lands in overlays/addressbook/affordances/contact-find-by-email.ttl so 'make reset'
# reproduces it; the addressbook manifest already lists this affordance.

@prefix wiki:     <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix prof:     <http://www.w3.org/ns/dx/prof/> .
@prefix wikirole: <https://pod.vardeman.me/vault/ontology/wikirole#> .

</vault/meta/affordances/contact-find-by-email.ttl>
    a wiki:Affordance ,
       prof:ResourceDescriptor ;
    prof:hasRole wikirole:query-affordance ;
    rdfs:label "Contact lookup by email" ;
    dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
    wiki:installedBy <https://pod.vardeman.me/vault/ontology/overlay#addressbook> ;
    sh:agentInstruction """
      Email-based contact lookup. Useful when processing inbound messages: given
      the sender's email address, find the corresponding Person card in the
      AddressBook to retrieve identity metadata, affiliations, and wiki links.

      Parameter: $email — the email IRI in mailto: form, e.g.,
      <mailto:user@example.org>. Must be passed as an IRI, not a plain string.

      Sources: </vault/contacts/people.ttl> (aggregated index) plus individual
      Person card files at /vault/contacts/Person/*/index.ttl. Start with the
      aggregated index; fall back to per-card traversal if not found.

      Returns 0..1 ?person IRIs. Multiple results indicate duplicate cards for
      the same email address — surface this to the user as a data quality issue.
    """ ;
    wiki:selectQuery """
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>

SELECT ?person WHERE {
  ?person vcard:hasEmail $email .
}
    """ .
