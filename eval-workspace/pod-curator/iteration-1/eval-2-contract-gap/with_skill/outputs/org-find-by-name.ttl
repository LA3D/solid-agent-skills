    as:published "2026-05-23T22:17:06Z"^^xsd:dateTime .

# --- PROPOSED CORRECTED DESCRIPTOR ------------------------------------------
</vault/meta/affordances/org-find-by-name.ttl>
    a wiki:Affordance , prof:ResourceDescriptor ;
    prof:hasRole wikirole:affordance ;
    rdfs:label "Organization Find by Name" ;
    dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
    wiki:installedBy <https://pod.vardeman.me/vault/ontology/overlay#addressbook> ;
    sh:agentInstruction """
      Case-insensitive organization name lookup across all Organization cards
      and the aggregated contacts index (where orgs are co-listed per SolidOS
      convention).

      Parameter: $name — a string fragment to match against vcard:fn (e.g.,
      "Notre Dame", "NSF"). Returns all ?org IRIs whose vcard:fn contains the
      fragment (case-insensitive). Disambiguate using org-find-by-ror when the
      result set is larger than 1.

      Sources: Organization cards at /vault/contacts/Organization/*/index.ttl
      plus </vault/contacts/people.ttl>. Pass both as --default-graph-uri
      sources when invoking via solid-pod sparql.

      The query filters on rdf:type vcard:Organization to exclude Person cards
      from the result set.
    """ ;
    wiki:selectQuery """
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>

SELECT ?org ?fn WHERE {
  ?org a vcard:Organization ;
       vcard:fn ?fn .
  FILTER(CONTAINS(LCASE(STR(?fn)), LCASE(STR($name))))
}
    """ .

