@prefix dct:      <http://purl.org/dc/terms/> .

# ===========================================================================
# CURATOR PROPOSAL (audit-and-propose only — NOT applied)
# Finding:    descriptor:untyped @ /vault/meta/affordances/bridge-card-to-wiki.ttl
# Class:      contract gap (construction) — playbook §"descriptor:untyped"
# NOTE: Same addressbook overlay, same gap as the contact-/org-find-* set.
#       Included to repair the full addressbook descriptor cluster, since it
#       is the 8th descriptor:untyped finding and ships from the same overlay.
# ===========================================================================

<urn:uuid:068dc04b-886b-442c-bb32-0ea8e0b52c84>
    a as:Announce, mem:RealignAction, prov:Activity ;
    as:actor <urn:agent:claude-code> ;
    as:target </vault/wiki/working/curator-proposals/> ;
    as:object </vault/meta/affordances/bridge-card-to-wiki.ttl> ;
    prov:wasAssociatedWith <urn:agent:claude-code> ;
    prov:used </vault/ontology/wiki> ;
    prov:wasDerivedFrom </vault/meta/affordances/bridge-card-to-wiki.ttl> ;
    mem:stalenessClass mem:ProseDrift ;
    mem:rationale "Same contract gap as the rest of the addressbook descriptor cluster: typed only wiki:Affordance, escapes the prof:ResourceDescriptor-targeted contract shape. Add PROF type + prof:hasRole/rdfs:label/dct:conformsTo/wiki:installedBy. Resolved against /vault/ontology/wiki + /vault/ontology/wikirole. SELECT read affordance — no dispatch predicates." ;
    as:published "2026-05-23T22:17:06Z"^^xsd:dateTime .

# --- PROPOSED CORRECTED DESCRIPTOR ------------------------------------------
</vault/meta/affordances/bridge-card-to-wiki.ttl>
    a wiki:Affordance , prof:ResourceDescriptor ;
    prof:hasRole wikirole:affordance ;
    rdfs:label "Bridge Card to Wiki Page" ;
    dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
    wiki:installedBy <https://pod.vardeman.me/vault/ontology/overlay#addressbook> ;
    sh:agentInstruction """
      Given a Person or Organization card IRI, find the wiki page that has
      this card as its foaf:primaryTopic. The wiki side declares the bridge;
      this query inverts it.

      Returns 0..1 wiki page URLs. Most cards have either zero (no narrative
      page yet) or one (the typical case). Multiple wiki pages targeting one
      card would be unusual but valid.

      Parameter: $card — the card IRI with hash fragment (e.g.,
      </vault/contacts/Person/c4e5.../index.ttl#this>).

      Sources required: the /vault/wiki/people/ container's .meta resources.
      Use solid-pod sparql with --default-graph-uri pointing at each relevant
      .meta (RQ-Pod-4 workaround).
    """ ;
    wiki:selectQuery """
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?wikiPage WHERE {
  ?wikiPage foaf:primaryTopic $card .
}
    """ .

